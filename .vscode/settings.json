{
  // Onde procurar o ambiente virtual. `venvPath` aponta a PASTA que contém o
  // `.venv`, e a extensão resolve o executável conforme o sistema: no Linux é
  // `.venv/bin/python`, no Windows é `.venv\Scripts\python.exe`. Aqui havia um
  // `defaultInterpreterPath` cravado no caminho do Linux, o que deixava o
  // interpretador sem selecionar no Windows — e o F5 do launch.json depende
  // dele. As tasks não sofriam disso porque já têm bloco `windows` próprio.
  "python.venvPath": "${workspaceFolder}/backend",
  "python.terminal.activateEnvironment": true,

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["tests"],

  "editor.formatOnSave": false,
  "editor.rulers": [110],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "[python]": { "editor.tabSize": 4 },
  "[javascriptreact]": { "editor.tabSize": 2 },
  "[javascript]": { "editor.tabSize": 2 },
  "[css]": { "editor.tabSize": 2 },
  "[json]": { "editor.tabSize": 2 },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.venv": true,
    "**/dados_clientes": true,
    "**/package-lock.json": true
  },

  // dados_clientes guarda planilha de cliente: não deve ser indexado nem versionado
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/dados_clientes/**": true
  }
}
