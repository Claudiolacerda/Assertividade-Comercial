{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Estrito onde protege de verdade. `noImplicitAny` fica desligado por ora:
       o resultado da análise vem do backend em Python e seria tipado a dedo em
       dezenas de pontos de uma vez. Os tipos que importam estão em tipos.ts, e
       o resto migra conforme cada arquivo for mexido. */
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "allowJs": false,

    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
