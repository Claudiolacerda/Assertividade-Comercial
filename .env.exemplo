# Copie para .env e preencha. NUNCA comite o .env real.

# ---- domínio (registrado no registro.br e apontando para o IP deste servidor)
DOMINIO=neriahdata.com.br
EMAIL_TLS=voce@seuemail.com.br

# ---- banco
POSTGRES_USER=assert_app
POSTGRES_PASSWORD=<senha forte, gere uma aleatória>
POSTGRES_DB=assertividade
# Para usar um Postgres gerenciado (Neon, Supabase, RDS) em vez do contêiner,
# preencha DATABASE_URL e remova o serviço "banco" do compose:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/assertividade

# ---- aplicação
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<troque, é o que assina os tokens de sessão>
PERMITIR_AUTOCADASTRO=False
TAMANHO_MAX_UPLOAD_MB=25

# ---- backup
RETENCAO_DIAS=14
