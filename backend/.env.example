# Copie para .env e ajuste. NUNCA comite o .env real.
AMBIENTE=producao

# Postgres (obrigatório: o isolamento por schema é recurso do Postgres)
DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/assertividade

# Gere uma chave nova: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-esta-chave
JWT_EXPIRA_MINUTOS=720

# Pasta onde as planilhas enviadas ficam guardadas
DIR_UPLOADS=dados_clientes
TAMANHO_MAX_UPLOAD_MB=25

# Domínios do frontend, separados por vírgula
ORIGENS_PERMITIDAS=https://seu-dominio.com.br

# Em produção normalmente False: você cria as contas dos clientes
PERMITIR_AUTOCADASTRO=False
