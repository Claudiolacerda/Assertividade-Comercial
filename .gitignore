# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Segredos e dados de cliente — nunca versionar
.env
backend/.env
backend/dados_clientes/
backups-local/
dados_clientes/
backups-local/

# relatorios/ guarda o .xlsx que o sistema GERA a partir da análise, e um
# relatório gerado contém tudo o que a planilha de origem continha: nome de
# cliente, observação, valor. Ele não estava ignorado, e um relatório de
# setembro com 38 nomes reais ficou versionado e público. A varredura que fiz
# na primeira limpeza pulava arquivos .xlsx por serem binários, e era num
# .xlsx que o dado estava. Nada aqui dentro é versionado.
relatorios/

# Planilhas em dados/: só os exemplos anonimizados ficam versionados.
# Qualquer arquivo real que você largar aqui fica fora do repositório por padrão.
dados/*
!dados/meta/
!dados/reunioes/
dados/meta/*
dados/reunioes/*
!dados/meta/*Exemplo*
!dados/reunioes/*Exemplo*

# Node
node_modules/
frontend/dist/

# Sistema
.DS_Store
~$*

# Skills de agente instaladas localmente (impeccable e afins).
# Ficam de fora do repositório: são ferramenta de quem desenvolve, não do produto,
# e versionar código de terceiro que roda com permissão total de agente é risco
# sem retorno. Reinstale com: npx skills add <url> --skill <nome>
.agents/
.claude/skills/
skills-lock.json
